{
  "name": "vite-plugin-lit-css",
  "description": "Plugin to get all the power of Vite styles with lit tagged-template ⚡",
  "version": "3.1.0",
  "type": "module",
  "repository": "https://github.com/redfox-mx/vite-lit-css",
  "keywords": [
    "vite-plugin",
    "lit",
    "lit-css",
    "vite-plugin-lit-css"
  ],
  "author": {
    "name": "Diego Jesus Hernández González",
    "email": "hernandezdj98@outlook.com",
    "aka": "redfox-mx"
  },
  "engines": {
    "node": ">=18.2.0"
  },
  "files": [
    "dist",
    "client.d.ts"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "scripts": {
    "build": "unbuild && tsx scripts/patchCJS.ts",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@rollup/pluginutils": "^5.3.0",
    "@types/node": "^20.19.40",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "rollup": "^4.60.3",
    "tsx": "^4.21.0",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "lit": "^2.0.0 || ^3.0.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "compatiblePackages": {
    "schemaVersion": 1,
    "vite": {
      "type": "compatible",
      "versions": "^7.0.0 || ^8.0.0"
    },
    "rollup": {
      "type": "incompatible",
      "reason": "Uses internal vite hooks"
    },
    "rolldown": {
      "type": "unknown"
    }
  },
  "packageManager": "pnpm@11.0.9+sha512.34ce82e6780233cf9cad8685029a8f81d2e06196c5a9bad98879f7424940c6817c4e4524fb7d38b8553ceed48b9758b8ebaf1abd3600c232c4c8cf7366086f38"
}